{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inkbot",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "BOT", "class_name": "BotRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_classes": ["BotRoom"] }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "BOT_NAME": "インクボット",
    "CHAT_WS": "wss://knj48-ver-chatsystem.onrender.com",
    "USE_SEARCH": "1"
  }
}
